{% sw_extends '@Storefront/storefront/component/listing/filter/filter-multi-select.html.twig' %}

{# Lists with more items than this threshold get a search field. #}
{% set brunkoFilterSearchThreshold = 8 %}

{% block component_filter_multi_select_list %}
    {% if elements|length > brunkoFilterSearchThreshold %}
        {% block brunko_filter_multi_select_search %}
            <div class="brunko-filter-search" data-brunko-filter-search="true">
                <label class="visually-hidden" for="{{ filterItemId }}-search">
                    {{ 'brunko.filter.searchLabel'|trans({'%displayName%': displayName})|striptags }}
                </label>
                <input type="search"
                       id="{{ filterItemId }}-search"
                       class="form-control brunko-filter-search-input"
                       autocomplete="off"
                       placeholder="{{ 'brunko.filter.searchPlaceholder'|trans|striptags }}">
            </div>
        {% endblock %}
    {% endif %}

    {{ parent() }}
{% endblock %}
