{% sw_extends '@Storefront/storefront/component/product/card/box-standard.html.twig' %}

{# Hide product description - only show image, name, and price #}
{% block component_product_box_description %}{% endblock %}

{# Second product image shown on hover (desktop). Falls back to the original cover when no other image exists. #}
{% block component_product_box_image_thumbnail %}
    {{ parent() }}

    {% block brunko_product_box_image_secondary %}
        {% set brunkoSecondaryImage = product.media.elements|default([])|filter(image =>
            image.id != product.cover.id
            and image.media
            and (image.media.mediaType is null or image.media.mediaType.name == 'IMAGE')
        )|first %}

        {% if brunkoSecondaryImage %}
            {% sw_thumbnails 'brunko-product-image-secondary' with {
                media: brunkoSecondaryImage.media,
                sizes: sizes,
                attributes: {
                    class: 'product-image product-image-secondary is-' ~ displayMode,
                    alt: '',
                    loading: 'lazy',
                    'aria-hidden': 'true'
                }
            } %}
        {% endif %}
    {% endblock %}
{% endblock %}
