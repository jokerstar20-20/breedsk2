{% sw_extends '@Storefront/storefront/component/product/card/price-unit.html.twig' %}

{#
    Hlavná cena. Pri zlavnenom produkte (pôvodná cena) sa cena zobrazí v rámčeku ako na Alze:
    "BLACK FRIDAY -27%" (november) alebo "LETÁKOVÁ AKCIA" (po zvyšok roka).
    Zapínanie/vypínanie: Admin > Rozšírenia > Moje rozšírenia > BrunkoNova > Konfigurovať.
    Text "(X% uložených)" pri cene sa nezobrazuje.
#}
{% block component_product_box_main_price %}
    {% set brunkoPromoMode = config('BrunkoNova.config.brunkoPromoMode') ?: 'auto' %}
    {% if brunkoPromoMode == 'auto' %}
        {% set brunkoPromoMode = ('now'|date('n')) == 11 ? 'blackfriday' : 'flyer' %}
    {% endif %}
    {% set brunkoShowPromo = isListPrice and not displayFrom and not displayFromVariants and brunkoPromoMode != 'off' %}

    {% if brunkoShowPromo %}
        {% if brunkoPromoMode == 'blackfriday' %}
            {% set brunkoPromoLabel = (config('BrunkoNova.config.brunkoPromoBlackFridayLabel') ?: 'Black Friday') ~ ' -' ~ price.listPrice.percentage|round ~ '%' %}
        {% else %}
            {% set brunkoPromoLabel = config('BrunkoNova.config.brunkoPromoFlyerLabel') ?: 'Letáková akcia' %}
        {% endif %}

        <span class="brunko-promo brunko-promo-{{ brunkoPromoMode }}">
            <span class="brunko-promo-label">{{ brunkoPromoLabel }}</span>
            <span class="brunko-price-line">
                <span class="brunko-promo-box">
                    {{ block('brunko_product_box_main_price_inner') }}
                </span>
            </span>
        </span>
    {% else %}
        <span class="brunko-price-line">
            {{ block('brunko_product_box_main_price_inner') }}
        </span>
    {% endif %}
{% endblock %}

{% block brunko_product_box_main_price_inner %}
    <span class="product-price{% if displaySalePrice %} with-list-price{% endif %}">
        {{ price.unitPrice|currency }}

        {% if isListPrice and not displayFrom and not displayFromVariants %}
            <span class="list-price">
                {% block component_product_box_main_price_before %}
                    {% sw_include '@Storefront/storefront/component/product/list-price-affix.html.twig' with {
                        position: 'before'
                    } %}
                {% endblock %}

                <span class="visually-hidden list-price-label">{{ 'listing.regularPriceLabel'|trans|sw_sanitize }}</span>

                <span class="list-price-price">{{ price.listPrice.price|currency }}</span>

                {% block component_product_box_main_price_after %}
                    {% sw_include '@Storefront/storefront/component/product/list-price-affix.html.twig' with {
                        position: 'after'
                    } %}
                {% endblock %}
            </span>
        {% endif %}
    </span>
{% endblock %}

{# V karte v listingu sa riadok "Ceny vrátane DPH plus náklady na dopravu" nezobrazuje. #}
{% block component_product_box_price_tax_info %}{% endblock %}
