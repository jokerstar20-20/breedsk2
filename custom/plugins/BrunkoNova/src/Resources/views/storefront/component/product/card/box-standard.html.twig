{% sw_extends '@Storefront/storefront/component/product/card/box-standard.html.twig' %}

{# Krátky popis pod názvom: čistý text, ostrihanie na riadky robí CSS (line-clamp). #}
{# Pozn.: RHWebFoundation prepisuje blok component_product_box_description a podmieňuje ho nastavením, preto sa popis vykresľuje tu. #}
{% block component_product_box_name %}
    {{ parent() }}

    {% set brunkoDescription = (product.translated.description ?? '')|striptags|trim|slice(0, 600) %}
    {% if brunkoDescription is not empty %}
        <p class="brunko-product-description">{{ brunkoDescription|sw_sanitize }}</p>
    {% endif %}
{% endblock %}

{# Dostupnosť sa vykresľuje vedľa ceny v price-unit.html.twig (blok component_product_box_main_price). #}
