{% sw_extends '@Storefront/storefront/component/product/card/badges.html.twig' %}

{# Odznak v rohu: "Akcia -27%" (vypočítané zo zľavy), namiesto holého "%". #}
{% block component_product_badges_discount %}
    {% set price = product.calculatedPrice %}
    {% if product.calculatedPrices.count > 0 %}
        {% set price = product.calculatedPrices.last %}
    {% endif %}

    {# A regulation price replaces the list price as the reference for the saving. #}
    {% set brunkoPercentage = (price.regulationPrice ?? price.listPrice).percentage %}
    {% set hasDiscount = brunkoPercentage > 0 %}
    {% set hasRange = product.calculatedPrices.count > 1 %}

    {% set displayParent = product.variantListingConfig.displayParent and product.parentId === null %}
    {% if displayParent %}
        {% set displayFromVariants = displayParent and price.unitPrice !== product.calculatedCheapestPrice.unitPrice %}
    {% endif %}

    {% if hasDiscount and not hasRange and not displayFromVariants %}
        <span class="badge bg-danger badge-discount">
            {{ 'brunko.listing.promoBadge'|trans|sw_sanitize }} -{{ brunkoPercentage|round }}%
        </span>
    {% endif %}
{% endblock %}

{# Dostupnosť pod odznakom akcie (na obrázku): "Skladom" (zelená) alebo "Dostupné" + dodacia lehota (z dodacej doby produktu). #}
{% block component_product_badges_topseller %}
    {% set brunkoInStock = product.available and product.availableStock >= product.minPurchase %}
    {# deliveryTime sa v listingu nenacitava, preto porovnanie podla ID dodacej doby "3-8 pracovnych dni" (vytvara ju import Autronic). #}
    {% set brunkoSlow = product.deliveryTimeId == 'ac52880d0d1c9559ba813e0dcb059236' %}
    <span class="badge brunko-availability-badge {{ not brunkoInStock ? 'is-unavailable' : 'is-available' }}{{ brunkoSlow ? ' is-delivery' : '' }}">
        {% if not brunkoInStock %}
            {{ 'brunko.listing.unavailable'|trans|sw_sanitize }}
        {% elseif brunkoSlow %}
            {{ 'brunko.listing.availableDelivery'|trans|sw_sanitize }}
        {% else %}
            {{ 'brunko.listing.available'|trans|sw_sanitize }}
        {% endif %}
    </span>
    {{ parent() }}
{% endblock %}
